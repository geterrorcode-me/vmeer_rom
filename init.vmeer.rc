# init.vmeer.rc - Optimized for vMeer Container Engine

on early-init
    # Set props dasar agar Android tidak mencari hardware asli
    setprop ro.debuggable 1
    setprop ro.secure 0
    mount debugfs debugfs /sys/kernel/debug

on init
    # Environment wajib agar library ditemukan
    export PATH /system/bin:/system/xbin
    export ANDROID_ROOT /system
    export ANDROID_DATA /data
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64
    
    # Setup socket untuk komunikasi inter-proses
    mkdir /dev/socket 0700 system

on boot
    # Memulai core services Android secara berurutan
    start servicemanager
    start hwservicemanager
    start surfaceflinger
    start zygote

# --- SERVICES ---

service logcat /system/bin/logcat -f /dev/kmsg
    class core
    user root
    group log
    oneshot

service servicemanager /system/bin/servicemanager
    class core
    user system
    group system readproc
    critical
    onrestart restart zygote

service hwservicemanager /system/bin/hwservicemanager
    class core
    user system
    group system readproc
    critical

service surfaceflinger /system/bin/surfaceflinger
    class core
    user system
    group graphics drmrpc
    onrestart restart zygote

service zygote /system/bin/app_process64 -Xzygote /system/bin --zygote --start-system-server
    class main
    priority -20
    user root
    group root readproc reserved_disk
    socket zygote stream 660 root system
    onrestart restart audioserver

